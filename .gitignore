# Database files
data/*.db
data/*.db-wal
data/*.db-shm

# Reports generated at runtime
reports/*
!reports/.gitkeep

# Live UART captures (saved boot logs)
uart_logs/

# Logs
logs/*
!logs/.gitkeep
*.log

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Binary executables and libraries in bin/
bin/*.exe
bin/*.dll
bin/*.zip
bin/*.so
*.rar

# Local AI-agent tooling (not part of the app)
.agents/
skills-lock.json

# Debug screenshots belong outside the repo root
/*.png

# PyInstaller output
/build/
/dist/

# Companion APK build output (rebuilt by companion/build.py)
/companion/build/
